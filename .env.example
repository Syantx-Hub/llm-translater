# Copy to .env (next to this file) or to ~/Library/Application Support/Subtitler/.env
# and fill in. .env files are git-ignored.

# Required to search and download subtitles: https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=

# Optional: a (free) OpenSubtitles account raises the daily download limit.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
